APP_NAME=PhD-Ass Clinical API
ENVIRONMENT=production
ALLOW_ORIGINS=https://app.example.com
CLINICAL_API_TRUSTED_HOSTS=app.example.com
DATABASE_URL=postgresql+psycopg://phd_ass:replace-with-db-password@127.0.0.1:5432/phd_ass
ODOO_BRIDGE_BASE_URL=https://odoo.internal.example.com
ODOO_BRIDGE_DB_NAME=replace-with-odoo-db
ODOO_BRIDGE_API_KEY=replace-with-odoo-bridge-key
ODOO_BRIDGE_TIMEOUT_SECONDS=10
ODOO_RECOMMENDED_MODULE=phd_ass_bridge
ODOO_RECOMMENDED_MODULE_LABEL=Endoscopy Clinical Workspace
CLINICAL_API_SESSION_TTL_MINUTES=120
CLINICAL_API_LOCAL_AUTH_PASSWORD=replace-with-strong-local-secret
CLINICAL_API_ENABLE_DOCS=false
CLINICAL_API_REQUIRE_HTTPS=true
CLINICAL_API_TRUST_FORWARDED_PROTO=true
CLINICAL_API_SECURITY_HEADERS_ENABLED=true
CLINICAL_API_HSTS_MAX_AGE_SECONDS=31536000
CLINICAL_API_LOGIN_WINDOW_SECONDS=900
CLINICAL_API_LOGIN_MAX_ATTEMPTS=5
CLINICAL_API_MAX_ACTIVE_SESSIONS_PER_USER=3
CLINICAL_API_SEED_SAMPLE_DATA=false
