APP_NAME=Endoscopy Reporting App
ENVIRONMENT=development
ALLOW_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
CLINICAL_API_TRUSTED_HOSTS=127.0.0.1,localhost,::1,testserver
DATABASE_URL=sqlite:///./clinical_api.db
ODOO_BRIDGE_BASE_URL=
ODOO_BRIDGE_DB_NAME=
ODOO_BRIDGE_API_KEY=
ODOO_BRIDGE_TIMEOUT_SECONDS=10
ODOO_RECOMMENDED_MODULE=phd_ass_bridge
ODOO_RECOMMENDED_MODULE_LABEL=Endoscopy Clinical Workspace
CLINICAL_API_SESSION_TTL_MINUTES=120
CLINICAL_API_LOCAL_AUTH_PASSWORD=replace-with-local-secret
CLINICAL_API_ENABLE_DOCS=true
CLINICAL_API_REQUIRE_HTTPS=false
CLINICAL_API_TRUST_FORWARDED_PROTO=true
CLINICAL_API_SECURITY_HEADERS_ENABLED=true
CLINICAL_API_HSTS_MAX_AGE_SECONDS=31536000
CLINICAL_API_LOGIN_WINDOW_SECONDS=900
CLINICAL_API_LOGIN_MAX_ATTEMPTS=5
CLINICAL_API_MAX_ACTIVE_SESSIONS_PER_USER=3
CLINICAL_API_SEED_SAMPLE_DATA=true
