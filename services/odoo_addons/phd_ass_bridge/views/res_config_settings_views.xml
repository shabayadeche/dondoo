<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_res_config_settings_phd_ass_bridge" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.phd.ass.bridge</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app string="Endoscopy Clinical Workspace" name="phd_ass_bridge">
          <block title="Clinical Service Integration">
            <setting string="Clinical API Base URL" help="Base URL for the clinical API service.">
              <field name="phd_ass_clinical_api_base_url"/>
            </setting>
            <setting string="Clinical API Service Key" help="Shared secret or token reference for integration calls.">
              <field name="phd_ass_clinical_api_key" password="True"/>
            </setting>
            <setting string="Clinical API Timeout Seconds" help="Timeout for integration requests from Odoo to the clinical service.">
              <field name="phd_ass_request_timeout_seconds"/>
            </setting>
            <setting string="Auto Push Drafts On Save" help="If enabled, draft edits made in Odoo are pushed to the clinical API after each save.">
              <field name="phd_ass_auto_push_on_save"/>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
