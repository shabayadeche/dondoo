# Recommended for the Nginx same-origin deployment in deploy/nginx/phd-ass.conf.example:
# leave the base URL blank so the PWA calls /api and /health on the same public host.
VITE_CLINICAL_API_BASE_URL=

# If the API must live on a separate public origin instead, set it explicitly:
# VITE_CLINICAL_API_BASE_URL=https://api.example.com
